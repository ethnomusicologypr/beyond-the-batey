      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "The Delegación de Cangrejos, directed by Caridad Sánchez-Martínez, presents a poetic tribute to the Puerto Rican composer and salsero Catalino \"Tite\" Curet Alonso . They then present the following cantos de bomba. \"Cunya de la Perona,\" \"Plena María,\" \"Miserere,\" \"Petronila Guillé,\" \"Mi Barriles,\" and \"La Borucana\"."
            }
          ]
        }
      ],
      "tags": [],
      "uuid": "529490df-72a5-44bc-91e7-00ae86f48ed0"
    },
